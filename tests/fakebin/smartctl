#!/usr/bin/env python3
# Fake smartctl: prints fixture JSON. /dev/sdd hangs (tests the timeout).
import os, sys, time
fix = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "fixtures")
args = sys.argv[1:]
if "--scan" in args:
    print(open(os.path.join(fix, "smart-scan.json")).read()); sys.exit(0)
if "--version" in args:
    print("smartctl 7.4 2023-08-01 r5530 (fake)"); sys.exit(0)
dev = os.path.basename(args[-1])
if dev == "sdd":
    time.sleep(120)
path = os.path.join(fix, "smart-%s.json" % dev)
if not os.path.exists(path):
    print('{"smartctl":{"exit_status":2,"messages":[{"string":"No such device"}]}}'); sys.exit(2)
import json
data = json.load(open(path))
print(json.dumps(data))
sys.exit(data["smartctl"]["exit_status"])
