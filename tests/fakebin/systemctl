#!/usr/bin/env python3
# Fake systemctl: --failed and show only. Refuses anything that would change state.
import sys
args = sys.argv[1:]
STATES = {"smbd.service": ("loaded", "active", "running"), "nmbd.service": ("loaded", "active", "running"),
          "jellyfin.service": ("loaded", "failed", "failed")}
if any(a in args for a in ("start", "stop", "restart", "enable", "disable", "kill", "reload")):
    sys.stderr.write("fake systemctl: refusing state change\n"); sys.exit(99)
if "--failed" in args:
    print("jellyfin.service loaded failed failed Jellyfin Media Server"); sys.exit(0)
if args and args[0] == "show":
    units = [a for a in args[1:] if not a.startswith("-") and "," not in a]
    out = []
    for u in units:
        load, active, sub = STATES.get(u, ("not-found", "inactive", "dead"))
        out.append("Id=%s\nLoadState=%s\nActiveState=%s\nSubState=%s\nResult=success\nActiveEnterTimestamp=\n" % (u, load, active, sub))
    print("\n".join(out)); sys.exit(0)
if "--version" in args:
    print("systemd 255 (fake)"); sys.exit(0)
sys.exit(1)
